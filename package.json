{
  "name": "anwesenheitsapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types tests/model.test.ts && node --experimental-strip-types tests/changes.test.ts && node --experimental-strip-types tests/consolidation.test.ts && node --experimental-strip-types tests/export.test.ts && node --experimental-strip-types tests/firebase-data.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-kursblick \"node --experimental-strip-types --test tests/firestore.rules.test.ts\"",
    "typecheck:firebase": "tsc --noEmit -p tsconfig.firebase.json"
  },
  "dependencies": {
    "firebase": "13.1.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase-tools": "15.34.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
